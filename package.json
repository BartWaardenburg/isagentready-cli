{
  "name": "isagentready",
  "version": "0.4.1",
  "packageManager": "pnpm@10.28.1",
  "description": "Scan any website for AI agent readiness from your terminal: scores, grades, and per-checkpoint fix steps and verify commands",
  "type": "module",
  "bin": {
    "isagentready": "dist/index.js"
  },
  "files": [
    "dist",
    "CONTEXT.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartwaardenburg/isagentready-cli.git"
  },
  "keywords": [
    "cli",
    "isagentready",
    "ai-readiness",
    "website-scanner",
    "agent-readiness",
    "ai",
    "mcp",
    "aeo",
    "seo",
    "automation",
    "llm",
    "agentready",
    "agent-ready",
    "checkpoints",
    "methodology"
  ],
  "author": "Bart Waardenburg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bartwaardenburg/isagentready-cli/issues"
  },
  "homepage": "https://github.com/bartwaardenburg/isagentready-cli#readme",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  }
}
